# Server Configuration
PORT=4000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.fao3vhd.mongodb.net/trading_terminal?retryWrites=true&w=majority&appName=Cluster0"

# JWT Authentication
JWT_SECRET="super-secret-jwt-key-change-in-production-min-32-chars-long"
JWT_REFRESH_SECRET="super-secret-refresh-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Google OAuth (Optional: for verifying Google ID tokens)
GOOGLE_CLIENT_ID=""

# Client CORS Origins
CLIENT_ORIGIN="*"

# Exchange Connection & Credentials
EXCHANGE_MODE="simulation" # "simulation" or "live"
EXCHANGE_API_KEY=""
EXCHANGE_ACCOUNT_ID=""
EXCHANGE_API_SECRET=""

# Propr / Hyperliquid Exchange Endpoints
PROPR_BETA_URL="https://api.beta.propr.xyz/v1"
PROPR_TEST_KEY=""
PROPR_ACCOUNT_ID=""
PROPR_WS_URL="wss://api.beta.propr.xyz/ws"
HYPERLIQUID_API_URL="https://api.hyperliquid.xyz/info"
